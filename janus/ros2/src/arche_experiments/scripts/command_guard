#!/usr/bin/env python3
import json
from time import monotonic

import rclpy
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from rclpy.clock import Clock, ClockType
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rosgraph_msgs.msg import Clock as ClockMessage
from std_msgs.msg import Bool, String

from arche_experiments.commands import CommandGuard
from arche_experiments.ros_fields import odometry_fields, stamp_s


class GuardNode(Node):
    def __init__(self):
        super().__init__("janus_command_guard")
        self.guard = CommandGuard(
            self.declare_parameter("command_timeout_s", 0.25).value,
            self.declare_parameter("odom_timeout_s", 0.25).value,
            self.declare_parameter("wall_clock_timeout_s", 0.50).value,
        )
        self.last_reason = None
        self.command = self.create_publisher(Twist, "/cmd_vel", 10)
        self.events = self.create_publisher(String, "/janus/command_guard/status", 10)
        self.create_subscription(ClockMessage, "/clock", self.clock_update, qos_profile_sensor_data)
        self.create_subscription(Odometry, "/odom", self.odometry, qos_profile_sensor_data)
        self.create_subscription(Twist, "/janus/cmd_vel/request", self.request, 10)
        self.create_subscription(Bool, "/janus/abort", self.abort, 10)
        # Keep sending zero on a paused or missing simulation clock.
        self.create_timer(0.02, self.send, clock=Clock(clock_type=ClockType.STEADY_TIME))

    def clock_update(self, msg):
        self.guard.clock(stamp_s(msg.clock), monotonic())

    def odometry(self, msg):
        try:
            odometry_fields(msg, "odom")
        except ValueError:
            self.guard.odometry(stamp_s(msg.header.stamp), valid=False)
        else:
            self.guard.odometry(stamp_s(msg.header.stamp))

    def request(self, msg):
        self.guard.request(msg.linear.x, msg.angular.z)

    def abort(self, msg):
        if msg.data:
            self.guard.abort()
            self.send()

    def send(self):
        output = self.guard.output(monotonic())
        msg = Twist()
        msg.linear.x = output.v_mps
        msg.angular.z = output.yaw_rate_radps
        self.command.publish(msg)
        if output.reason != self.last_reason:
            self.events.publish(String(data=json.dumps({"time_s": self.guard.now, "reason": output.reason})))
            self.last_reason = output.reason


def main():
    rclpy.init()
    node = GuardNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
