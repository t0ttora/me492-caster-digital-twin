<?xml version="1.0"?>
<sdf version="1.9">
  <world name="janus">
    <gravity>0 0 -9.81</gravity>
    <physics name="janus_1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.85 0.87 0.89 1</background></scene>
    <light name="key" type="directional">
      <direction>1 0 -1</direction><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.1 0.1 0.1 1</specular>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="slab">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="floor"><geometry><box><size>20 20 0.10</size></box></geometry><surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface></collision>
        <visual name="floor"><geometry><box><size>20 20 0.10</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <include><uri>model://arche_janus</uri><name>arche</name><pose>0 0 0.077 0 0 0</pose></include>
    <include><uri>model://janus_dock</uri><pose>1.50 0 0.31 0 0 0</pose></include>
  </world>
</sdf>
