<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><created>2026-11-27T00:00:00Z</created><modified>2026-11-27T00:00:00Z</modified><unit meter="1" name="meter"/><up_axis>Z_UP</up_axis></asset>
  <library_images><image id="qr-image"><init_from>marker.png</init_from></image></library_images>
  <library_effects><effect id="qr-effect"><profile_COMMON>
    <newparam sid="qr-surface"><surface type="2D"><init_from>qr-image</init_from></surface></newparam>
    <newparam sid="qr-sampler"><sampler2D><source>qr-surface</source></sampler2D></newparam>
    <technique sid="common"><lambert><diffuse><texture texture="qr-sampler" texcoord="UVSET0"/></diffuse></lambert></technique>
  </profile_COMMON></effect></library_effects>
  <library_materials><material id="qr-material"><instance_effect url="#qr-effect"/></material></library_materials>
  <library_geometries><geometry id="placard"><mesh>
    <source id="positions">
      <float_array id="pos" count="12">0 0.12 0.12  0 -0.12 0.12  0 -0.12 -0.12  0 0.12 -0.12</float_array>
      <technique_common><accessor source="#pos" count="4" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
    </source>
    <source id="normals">
      <float_array id="norm" count="3">-1 0 0</float_array>
      <technique_common><accessor source="#norm" count="1" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
    </source>
    <source id="uvs">
      <float_array id="uv" count="8">0 1  1 1  1 0  0 0</float_array>
      <technique_common><accessor source="#uv" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common>
    </source>
    <vertices id="vertices"><input semantic="POSITION" source="#positions"/></vertices>
    <triangles material="qr" count="2">
      <input semantic="VERTEX" source="#vertices" offset="0"/><input semantic="NORMAL" source="#normals" offset="1"/>
      <input semantic="TEXCOORD" source="#uvs" offset="2" set="0"/><p>0 0 0  2 0 2  1 0 1  0 0 0  3 0 3  2 0 2</p>
    </triangles>
  </mesh></geometry></library_geometries>
  <library_visual_scenes><visual_scene id="scene"><node id="plate"><instance_geometry url="#placard"><bind_material><technique_common>
    <instance_material symbol="qr" target="#qr-material"><bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0"/></instance_material>
  </technique_common></bind_material></instance_geometry></node></visual_scene></library_visual_scenes>
  <scene><instance_visual_scene url="#scene"/></scene>
</COLLADA>
