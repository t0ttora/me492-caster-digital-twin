#!/usr/bin/env python3
import argparse
import hashlib
import json

import rclpy
from geometry_msgs.msg import Twist
from rclpy.clock import Clock, ClockType
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.utilities import remove_ros_args
from std_msgs.msg import String

from arche_experiments.commands import VELOCITY, load_commands


class ReplayNode(Node):
    def __init__(self, series, run_id, source_hash):
        super().__init__("janus_velocity_replay", parameter_overrides=[Parameter("use_sim_time", value=True)])
        self.series = series
        self.run_id = run_id
        self.source_hash = source_hash
        self.start_ns = self.last_ns = None
        self.done = False
        self.reason = None
        self.pub = self.create_publisher(Twist, "/janus/cmd_vel/request", 10)
        self.events = self.create_publisher(String, "/janus/replay/event", 10)
        self.create_timer(0.01, self.tick, clock=Clock(clock_type=ClockType.STEADY_TIME))

    def event(self, kind, now_ns):
        self.events.publish(String(data=json.dumps({
            "event": kind, "run_id": self.run_id, "sim_time_s": now_ns / 1e9,
            "command_sha256": self.source_hash,
        })))

    def tick(self):
        now = self.get_clock().now().nanoseconds
        if self.start_ns is None:
            if not now or not self.pub.get_subscription_count():
                return
            self.start_ns = now
            self.event("replay_start", now)
        if self.last_ns is not None and now < self.last_ns:
            self.stop("clock_reset")
            return
        if now == self.last_ns:
            return
        self.last_ns = now
        elapsed = (now - self.start_ns) / 1e9
        if elapsed >= self.series.time[-1]:
            self.stop("replay_end")
            return
        msg = Twist()
        msg.linear.x, msg.angular.z = self.series.hold(elapsed)
        self.pub.publish(msg)

    def stop(self, reason):
        if not self.done:
            self.pub.publish(Twist())
            self.event(reason, self.get_clock().now().nanoseconds)
            self.reason = reason
            self.done = True


def main():
    parser = argparse.ArgumentParser(description="Replay a velocity CSV in Gazebo simulation time.")
    parser.add_argument("commands")
    parser.add_argument("--run-id", required=True)
    args = parser.parse_args(remove_ros_args()[1:])
    series = load_commands(args.commands)
    if series.schema != VELOCITY:
        parser.error("only velocity commands can drive DiffDrive")
    with open(args.commands, "rb") as stream:
        source_hash = hashlib.file_digest(stream, "sha256").hexdigest()
    rclpy.init()
    node = ReplayNode(series, args.run_id, source_hash)
    try:
        while rclpy.ok() and not node.done:
            rclpy.spin_once(node, timeout_sec=0.1)
        node.pub.wait_for_all_acked(timeout=Duration(seconds=0.5))
        node.events.wait_for_all_acked(timeout=Duration(seconds=0.5))
    except KeyboardInterrupt:
        if rclpy.ok():
            node.stop("replay_interrupted")
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
    return 0 if node.reason == "replay_end" else 1


if __name__ == "__main__":
    raise SystemExit(main())
